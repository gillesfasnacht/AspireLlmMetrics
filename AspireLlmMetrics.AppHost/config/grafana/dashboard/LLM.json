{
  "schemaVersion": 39,
  "tags": [
    "LLM",
    "Aspire"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "targets": [
        {
          "expr": "sum by (llm_model) (rate(llm_requests_total[$__rate_interval]))",
          "legendFormat": "{{llm_model}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "uid": "PBFA97CFB590B2093",
        "type": "prometheus"
      },
      "title": "Tentatives LLM / seconde",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "x": 0,
        "y": 0.0,
        "w": 12
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "targets": [
        {
          "expr": "sum by (__name__, llm_model) (rate({__name__=~\"llm_(successes|errors|cancellations)_total\"}[$__rate_interval]))",
          "legendFormat": "{{__name__}} / {{llm_model}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "uid": "PBFA97CFB590B2093",
        "type": "prometheus"
      },
      "title": "Résultats / seconde",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "x": 12,
        "y": 0.0,
        "w": 12
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, llm_model, llm_outcome) (rate(llm_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{llm_model}} / {{llm_outcome}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "uid": "PBFA97CFB590B2093",
        "type": "prometheus"
      },
